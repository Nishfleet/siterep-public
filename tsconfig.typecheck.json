{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  // Every worker module is typechecked by default. The exclude list below is
  // the legacy files not yet clean under strict checkJs (being split in #266);
  // do not add new files to it.
  "include": ["worker/**/*.js"],
  "exclude": [
    "worker/compose.js",
    "worker/honesty-evals.js",
    "worker/index.js",
    "worker/routes/sources.js",
    "worker/sentry.js",
    "worker/site-rep-mcp.js"
  ]
}
